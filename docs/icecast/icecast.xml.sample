<?xml version="1.0"?>
<!-- Образец icecast2: живые потоки станций для GTA RADIO.
     Положи в /etc/icecast2/icecast.xml, поправь hostname и пароли. -->
<icecast>
  <location>Earth</location>
  <admin>admin@твой-домен.ru</admin>

  <hostname>audio.твой-домен.ru</hostname>

  <listen-socket>
    <port>8000</port>
  </listen-socket>

  <!-- source-клиенты (liquidsoap) льют эфир под этими креденшиалами -->
  <source-password>CHANGE_ME_SOURCE</source-password>
  <admin-password>CHANGE_ME_ADMIN</admin-password>
  <relay-password>CHANGE_ME_RELAY</relay-password>

  <fileserve>1</fileserve>
  <shoutcast-mount>/live.nsv</shoutcast-mount>

  <paths>
    <basedir>/usr/share/icecast2</basedir>
    <logdir>/var/log/icecast2</logdir>
    <webroot>/usr/share/icecast2/web</webroot>
    <adminroot>/usr/share/icecast2/admin</adminroot>
    <alias source="/" destination="/status.xsl"/>
  </paths>

  <logging>
    <accesslog>access.log</accesslog>
    <errorlog>error.log</errorlog>
    <playlistlog>playlist.log</playlistlog>
    <loglevel>3</loglevel>
    <logsize>10000</logsize>
  </logging>

  <security>
    <chroot>0</chroot>
  </security>

  <!-- ВАЖНО: CORS, иначе браузер сайта не примет поток -->
  <http-headers>
    <header name="Access-Control-Allow-Origin" value="*" />
    <header name="Access-Control-Expose-Headers" value="icy-name, icy-br" />
  </http-headers>

  <!-- публичный список станций и метаданные -->
  <mount type="normal">
    <mount-name>/status-json.xsl</mount-name>
    <public>1</public>
  </mount>
</icecast>
